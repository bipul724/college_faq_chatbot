# Copy to .env and edit
COLLEGE_NAME=ABES Engineering College
EMBEDDING_BACKEND=hf          # hf (sentence-transformers) | hash (offline, no download)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_BACKEND=ollama            # ollama | none (returns retrieved passages only)
OLLAMA_MODEL=llama3.2:3b      # small enough for an 8GB laptop
OLLAMA_URL=http://localhost:11434
MIN_RELEVANCE=0.25
